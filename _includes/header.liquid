<script>
  (function () {
    try {
      if (localStorage.getItem("site-lang") === "zh") {
        document.documentElement.classList.add("lang-zh");
        document.documentElement.lang = "zh-CN";
      }
    } catch (error) {}
  })();
</script>
{% if page.title_zh %}
  <script>
    document.documentElement.dataset.titleZh = {{ page.title_zh | jsonify }};
  </script>
{% elsif page.permalink == '/' %}
  <script>
    document.documentElement.dataset.titleZh = "王灿";
  </script>
{% endif %}
<style>
  .lang-only[data-lang="zh"] {
    display: none;
  }
  html.lang-zh .lang-only[data-lang="en"] {
    display: none;
  }
  html.lang-zh .lang-only[data-lang="zh"] {
    display: revert;
  }
  .lang-switch-group {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--global-divider-color);
    border-radius: 999px;
    overflow: hidden;
    line-height: 1;
  }
  .lang-switch-btn {
    border: 0;
    background: transparent;
    color: var(--global-text-color);
    font: inherit;
    font-size: 0.78rem;
    line-height: 1;
    padding: 0.38rem 0.55rem;
    cursor: pointer;
  }
  .lang-switch-btn:hover {
    color: var(--global-hover-color);
  }
  html:not(.lang-zh) .lang-switch-btn[data-set-lang="en"],
  html.lang-zh .lang-switch-btn[data-set-lang="zh"] {
    background: var(--global-theme-color);
    color: #fff;
  }
  .lang-switch-desktop {
    display: flex;
    align-items: center;
    margin-right: 0.35rem;
  }
  .lang-switch-mobile {
    display: none;
    margin-left: 0.4rem;
  }
  @media (max-width: 575.98px) {
    .lang-switch-desktop {
      display: none !important;
    }
    .lang-switch-mobile {
      display: inline-flex;
    }
  }
</style>
<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            <span class="lang-only" data-lang="en">
              {% if site.first_name %}
                <span class="font-weight-bold">
                  {{- site.first_name -}}
                </span>
              {% endif %}
              {% if site.middle_name %}
                {{- site.middle_name -}}
              {% endif %}
              {% if site.last_name %}
                {{- site.last_name -}}
              {% endif %}
            </span>
            <span class="lang-only" data-lang="zh">王灿</span>
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">
          <span class="lang-only" data-lang="en">Toggle navigation</span>
          <span class="lang-only" data-lang="zh">展开导航</span>
        </span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="lang-switch lang-switch-mobile" role="group" aria-label="Language">
        <div class="lang-switch-group">
          <button type="button" class="lang-switch-btn" data-set-lang="en" aria-pressed="true">EN</button>
          <button type="button" class="lang-switch-btn" data-set-lang="zh" aria-pressed="false">中文</button>
        </div>
      </div>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% assign about_title = '' %}
          {% assign about_title_zh = '' %}
          {% for item in site.pages %}
            {% if item.permalink == '/' %}
              {% assign about_title = item.title %}
              {% assign about_title_zh = item.title_zh %}
            {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              <span class="lang-only" data-lang="en">{{ about_title }}</span>
              <span class="lang-only" data-lang="zh">{{ about_title_zh | default: about_title }}</span>
              {% if page.permalink == '/' %}
                <span class="sr-only">
                  <span class="lang-only" data-lang="en">(current)</span>
                  <span class="lang-only" data-lang="zh">（当前）</span>
                </span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    <span class="lang-only" data-lang="en">{{ p.title }}</span>
                    <span class="lang-only" data-lang="zh">{{ p.title_zh | default: p.title }}</span>
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">
                        <span class="lang-only" data-lang="en">(current)</span>
                        <span class="lang-only" data-lang="zh">（当前）</span>
                      </span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    <span class="lang-only" data-lang="en">{{ p.title }}</span>
                    <span class="lang-only" data-lang="zh">{{ p.title_zh | default: p.title }}</span>
                    {% if page.url contains p.url %}
                      <span class="sr-only">
                        <span class="lang-only" data-lang="en">(current)</span>
                        <span class="lang-only" data-lang="zh">（当前）</span>
                      </span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          <li class="nav-item lang-switch lang-switch-desktop">
            <div class="lang-switch-group" role="group" aria-label="Language">
              <button type="button" class="lang-switch-btn" data-set-lang="en" aria-pressed="true">EN</button>
              <button type="button" class="lang-switch-btn" data-set-lang="zh" aria-pressed="false">中文</button>
            </div>
          </li>
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
<script defer src="{{ '/assets/js/lang.js' | relative_url }}"></script>
