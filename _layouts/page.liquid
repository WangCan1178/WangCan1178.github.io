---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if page.title_zh %}
        <span class="lang-only" data-lang="en">{{ page.title }}</span>
        <span class="lang-only" data-lang="zh">{{ page.title_zh }}</span>
      {% else %}
        {{ page.title }}
      {% endif %}
    </h1>
    <p class="post-description">
      {% if page.description_zh %}
        <span class="lang-only" data-lang="en">{{ page.description }}</span>
        <span class="lang-only" data-lang="zh">{{ page.description_zh }}</span>
      {% else %}
        {{ page.description }}
      {% endif %}
    </p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>
      <span class="lang-only" data-lang="en">References</span>
      <span class="lang-only" data-lang="zh">参考文献</span>
    </h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.plugins contains 'al_comments' %}
    {% include plugins/al_comments.liquid %}
  {% endif %}
</div>
